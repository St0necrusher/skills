#!/bin/sh
# Usage: wait-report <agent> <reply-path> [--prompt <pointer>] [--timeout <min>] [--quiet <min>]
# Waits until the last line of <reply-path> is exactly the end marker, then prints
# REPORT_READY. Every request gets a fresh reply path, so a marker there always belongs to
# this request, and rerunning the wait after any other outcome still finds a finished reply.
# With --prompt, the one-line pointer is first sent through `herdr agent prompt`.
# Other outcomes: NOT_SENT_BLOCKED (Herdr rejected the pointer because the agent sits on a
# prompt; resend it once the prompt is resolved), BLOCKED (the agent sits on a permission
# prompt after receiving the request), GONE (the agent is no longer listed), NO_REPORT (the
# agent stayed idle/done for --quiet minutes without a reply; default 5, 0 never), TIMEOUT
# (--timeout minutes, default 120), SEND_FAILED (Herdr refused the pointer for another reason).
agent=$1; reply=$2; shift 2; prompt=; timeout=120; quiet=5
while [ $# -gt 1 ]; do
  case $1 in --prompt) prompt=$2 ;; --timeout) timeout=$2 ;; --quiet) quiet=$2 ;; esac; shift 2
done
ended() { [ "$(tail -n 1 "$reply" 2>/dev/null)" = '<!-- end of reply -->' ]; }
if [ -n "$prompt" ]; then
  out=$(herdr agent prompt "$agent" "$prompt" 2>&1)
  case $out in
    *agent_blocked*) echo "NOT_SENT_BLOCKED $agent"; exit 6 ;;
    *'"error"'*) echo "SEND_FAILED $agent $(echo "$out" | grep -o '"message":"[^"]*"' | head -1)"; exit 5 ;;
  esac
fi
i=0; settled=0
while [ "$i" -lt $((timeout * 12)) ]; do
  ended && { echo "REPORT_READY $reply"; exit 0; }
  case $(herdr agent get "$agent" 2>/dev/null | grep -oE '"agent_status":"[a-z]+"' | cut -d'"' -f4) in
    "") echo "GONE $agent"; exit 4 ;;
    blocked) echo "BLOCKED $agent"; exit 3 ;;
    idle|done) settled=$((settled + 1))
      [ "$quiet" -gt 0 ] && [ "$settled" -ge $((quiet * 12)) ] && { echo "NO_REPORT $agent"; exit 2; } ;;
    *) settled=0 ;;
  esac
  sleep 5; i=$((i + 1))
done
echo "TIMEOUT $agent"; exit 1
